# Ethereum Sepolia RPC used by source-chain scripts and the proof worker.
SOURCE_CHAIN_RPC_URL=

# Creditcoin CC3 Testnet RPC used to submit Attestcoin proofs.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Hosted Attestcoin proof builder service.
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Creditcoin's internal key for the configured source chain.
SOURCE_CHAIN_KEY=1

# Development-only key used by deployment and worker scripts.
DEPLOYER_PRIVATE_KEY=
