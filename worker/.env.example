# Sepolia JSON-RPC endpoint used to scan SimpleLoanBook logs.
SOURCE_CHAIN_RPC_URL=

# Creditcoin CC3 Testnet JSON-RPC endpoint used to submit proofs.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Hosted Attestcoin proof builder service.
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Creditcoin internal chain key for Ethereum Sepolia.
SOURCE_CHAIN_KEY=1

# Deployed source-chain SimpleLoanBook address.
SOURCE_LOAN_BOOK_ADDRESS=

# Deployed Creditcoin CreditPassport address.
CREDIT_PASSPORT_ADDRESS=

# First block to scan when worker/state.json does not exist.
START_BLOCK=0

# Private key for the Creditcoin account that pays submission gas.
DEPLOYER_PRIVATE_KEY=

# Optional tuning values.
SOURCE_CONFIRMATIONS=12
SCAN_INTERVAL_MS=15000
MAX_BLOCK_RANGE=2000
STATE_FILE=worker/state.json
