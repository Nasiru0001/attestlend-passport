# Optional Vite overrides. The app has the current deployed addresses as
# defaults, but these values are useful when deploying a new contract version.
VITE_TEST_TOKEN_ADDRESS=
VITE_LOAN_BOOK_ADDRESS=
VITE_CREDIT_PASSPORT_ADDRESS=

# WalletConnect project ID used by RainbowKit's wallet connectors.
VITE_WALLETCONNECT_PROJECT_ID=
